# E2E test environment — copy to .env.test
# DATABASE_URL must point to a LOCAL database ending with "_test" (create it once: createdb linked_me_test)
# All its tables are emptied on each run.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/linked_me_test?schema=public"

JWT_SECRET="test-secret"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_SECRET="test-refresh-secret"
JWT_REFRESH_EXPIRY="7d"

APP_URL="http://localhost:3000"
ALLOWED_REDIRECT_ORIGINS="http://localhost:4200"

# Mail is replaced by a fake in E2E tests: this key is never used
RESEND_API_KEY="re_test_fake"
MAIL_FROM="test@linked-me.test"

ADMIN_EMAIL="admin@linked-me.test"
ADMIN_PASSWORD="Admin-Test-123!"

UNVERIFIED_USER_TTL_HOURS=24
AUDIT_LOG_TTL_DAYS=30
